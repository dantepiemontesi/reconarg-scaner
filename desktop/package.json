{
  "name": "reconarg-desktop",
  "version": "2.0.0",
  "description": "Diagnostico Express ReconARG - App portable",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/reconarg-diagnostico-win.exe",
    "build:linux": "pkg . --targets node18-linux-x64 --output dist/reconarg-diagnostico-linux",
    "build": "npm run build:win && npm run build:linux"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": ["node18-win-x64", "node18-linux-x64"],
    "outputPath": "dist"
  }
}
